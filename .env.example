# Copy to .env (git-ignored) and fill in only what you need. docker compose reads it automatically.

# Leave empty for the offline demo model. Set your own key to answer with Claude via Spring AI.
ANTHROPIC_API_KEY=
# Claude model id used when a key is set
ANTHROPIC_MODEL=claude-opus-5-5
# auto = Claude when ANTHROPIC_API_KEY is set, demo otherwise. Force with demo / anthropic.
COPILOT_MODE=auto

# Shared HS256 secret: the settlement platform signs tokens with it, the copilot verifies them.
# Local-only default; real deployments inject their own (32+ characters).
APP_JWT_SECRET=local-docker-only-secret-change-me-0123456789

# Host ports (chosen to avoid the settlement platform's own 18080/15433/3200 and other stacks)
COPILOT_WEB_PORT=3300
COPILOT_API_PORT=18090
VECTOR_DB_PORT=15434
SETTLEMENT_API_PORT=18081
SETTLEMENT_WEB_PORT=3201
